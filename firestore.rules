rules_version = '2';

// Firestore セキュリティルール
// 「誰が、どのデータを、読めるか・書けるか」を決める。書いていないものはすべて禁止。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 有効なスタッフ：ログイン情報の印（カスタムクレーム）があり、
    // かつスタッフ名簿（staff）で「有効」になっている人。無効にされた人はすぐ読めなくなる。
    function isStaff() {
      return signedIn()
        && request.auth.token.role in ['admin', 'staff']
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isStaff() && request.auth.token.role == 'admin';
    }
    // その日の作業配置表で「集荷係」（枠のID pickup）に名前が入っている従業員か（収穫管理をその日だけ使える）
    function isPickupOn(date) {
      return isWorker()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && exists(/databases/$(database)/documents/haichi/$(date))
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId
          in get(/databases/$(database)/documents/haichi/$(date)).data.cells.get('pickup', {'members': []}).members;
    }
    // 経理担当（現金出納帳を見るだけ）。ログインはスタッフと同じく管理者が作る
    function isAccounting() {
      return signedIn()
        && request.auth.token.role == 'accounting'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    // 温度の見張り担当の従業員か
    function isTempWatcher() {
      return isWorker()
        && exists(/databases/$(database)/documents/config/tempWatch)
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId
          in get(/databases/$(database)/documents/config/tempWatch).data.watchers;
    }
    // 管理者本人（温度の見張りの設定で決めた人）の従業員のログインか。警報のリセットができる
    function isTempOwner() {
      return isWorker()
        && exists(/databases/$(database)/documents/config/tempWatch)
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId
          == get(/databases/$(database)/documents/config/tempWatch).data.get('owner', '');
    }
    // 勤務管理表で「収穫管理を毎日使える」にした従業員（社員など）か
    function isHarvestWorker() {
      return isWorker()
        && get(/databases/$(database)/documents/shiftMembers/$(get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId)).data.get('harvestEntry', false) == true;
    }
    // 日付（YYYY-MM-DD）が、8日前から明日までか
    function recentDay(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])) > request.time - duration.value(9, 'd')
        && timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])) < request.time + duration.value(2, 'd');
    }
    // 日付（YYYY-MM-DD）が、今日あたり（日本の今日と、その前後の日）か
    function nearToday(date) {
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])) > request.time - duration.value(1, 'd')
        && timestamp.date(int(date[0:4]), int(date[5:7]), int(date[8:10])) < request.time + duration.value(1, 'd');
    }
    // 収穫者が「入った・終わった」を押したときの書き込みか：今日の分の、1つのハウス（tapHouse）の「入った・終わった」の時刻だけ。
    // ケース数や収穫者、ほかのハウスは変えられない
    function tapWrite(date) {
      let before = resource == null ? {} : resource.data;
      let hb = before.get('houses', {});
      let ha = request.resource.data.get('houses', {});
      let k = request.resource.data.get('tapHouse', '');
      return isWorker() && nearToday(date)
        && request.resource.data.diff(before).affectedKeys().hasOnly(['houses', 'tapHouse', 'updatedAt'])
        && k is string && k in ha
        && ha.diff(hb).affectedKeys().hasOnly([k])
        && tapHouse(hb, ha, k);
    }
    function tapHouse(hb, ha, k) {
      return ha[k] is map
        && ha[k].diff(hb.get(k, {})).affectedKeys().hasOnly(['start', 'end', 'helpers'])
        && minuteOrNull(ha[k], 'start') && minuteOrNull(ha[k], 'end')
        && (!('helpers' in ha[k]) || onlyMeChanged(hb.get(k, {}).get('helpers', []), ha[k].helpers));
    }
    // 応援の人の名前：増えた・減ったのが自分（従業員の id）だけか
    function onlyMeChanged(before, after) {
      let me = get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId;
      return after is list && after.size() <= 20
        && after.toSet().difference(before.toSet()).hasOnly([me])
        && before.toSet().difference(after.toSet()).hasOnly([me]);
    }
    // 時刻（0時からの分）か、空か、入っていない
    function minuteOrNull(m, k) {
      return !(k in m) || m[k] == null || (m[k] is int && m[k] >= 0 && m[k] < 1440);
    }
    // 従業員（勤務管理表を見る・休みの希望を出すだけの人）。ログインはサーバー側で作る
    function isWorker() {
      return signedIn()
        && request.auth.token.role == 'worker'
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.active == true;
    }

    // スタッフ名簿：スタッフは見るだけ。追加・変更はサーバー側（Cloud Functions）だけが行う
    match /staff/{uid} {
      allow read: if isStaff();
    }

    // 予約：スタッフは見るだけ。追加・変更・削除はサーバー側で定員を確かめてから行う
    match /reservations/{id} {
      allow read: if isStaff();
    }
    // 予約の連絡先（電話・メール）：スタッフだけが見られる。お客様本人も含め、他の人は読めない
    match /reservationContacts/{id} {
      allow read: if isStaff();
    }
    // 会計・売掛：スタッフは見るだけ。確定・取消・変更はサーバー側でまとめて行う
    match /sales/{id} {
      allow read: if isStaff();
    }
    match /receivables/{id} {
      allow read: if isStaff();
    }
    // 過去売上の取り込み（日ごとの合計）：スタッフは見るだけ、管理者が取り込む
    match /importedSales/{date} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['amount', 'source', 'importedAt'])
        && request.resource.data.amount is int;
      allow delete: if isAdmin();
    }

    // 顧客リスト（名前・連絡先・顧客ごとの単価）：スタッフは見るだけ（会計で使う）、管理者が登録・変更する
    match /customers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'kana', 'phone', 'address', 'contract', 'payment', 'terms', 'memo', 'prices', 'products', 'active', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('prices' in request.resource.data) || request.resource.data.prices is map)
        && (!('products' in request.resource.data) || (request.resource.data.products is map && request.resource.data.products.size() <= 200));
      allow delete: if isAdmin();
    }

    // レジ精算（日ごと）：スタッフが記録する。決められた項目だけ
    match /cashCounts/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['float', 'counts', 'cashSales', 'counted', 'diff', 'memo', 'updatedAt', 'updatedBy'])
        && request.resource.data.float is int
        && request.resource.data.counts is map
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // 請求書の設定（振込先など）：スタッフは見るだけ（請求書に印刷する）、変更は管理者
    match /config/invoice {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['bankInfo', 'note', 'issuerName', 'updatedAt'])
        && request.resource.data.bankInfo is string
        && request.resource.data.bankInfo.size() <= 500
        && (!('issuerName' in request.resource.data) || (request.resource.data.issuerName is string && request.resource.data.issuerName.size() <= 100));
    }

    // 請求書・納品書に押す印鑑（角印）の画像：スタッフは見るだけ（印刷する）、登録・削除は管理者
    match /config/invoiceSeal {
      allow read: if isStaff();
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 600000
        && request.resource.data.image.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$');
    }

    // レジの共通設定（領収書の「扱者」に選ぶ名前のリスト）：スタッフが見て、直せる
    // メニューのタイルの配置：スタッフが読み、管理者が変える
    match /config/menu {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['slots', 'cols', 'updatedAt'])
        && request.resource.data.slots is map
        && request.resource.data.slots.size() <= 60
        && request.resource.data.cols is int
        && request.resource.data.cols >= 2 && request.resource.data.cols <= 6;
    }
    // 現金出納帳の「項目」の候補（プルダウン）：管理者だけ
    match /config/cashbookItems {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }
    match /config/register {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['handlers', 'updatedAt'])
        && request.resource.data.handlers is list
        && request.resource.data.handlers.size() <= 30;
    }

    // 去年の商品別の実績（Airレジの商品別CSV）：スタッフは見るだけ、管理者が取り込む
    match /itemReferences/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['from', 'to', 'items', 'importedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
      allow delete: if isAdmin();
    }

    // 空き状況（時間枠ごとの予約人数だけ）：予約ページで使うので誰でも読める。書き込みはサーバー側のみ
    match /availability/{date} {
      allow read: if true;
    }

    // この日だけの定員（時間枠ごと）：予約ページで使うので誰でも読める。変更は管理者だけ
    match /dailyCapacity/{date} {
      allow read: if true;
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['slots', 'stopped', 'updatedAt'])
        && (!('slots' in request.resource.data) || request.resource.data.slots is map)
        && (!('stopped' in request.resource.data) || request.resource.data.stopped is map);
    }

    // ---------- 給与（管理者だけ。スタッフには一切見せない） ----------
    // 従業員（氏名・振込先の口座など）
    match /employees/{id} {
      allow read, write: if isAdmin();
    }
    // 月ごとの給与（payrolls/{YYYY-MM}）
    // 気象データ（気象庁のアメダス・月ごと）：スタッフが見る。取り込みはサーバー側だけ
    match /weather/{month} {
      allow read: if isStaff();
    }
    // 天気予報（気象庁・上川地方）。書き込みはサーバー側だけ
    match /forecast/{id} {
      allow read: if isStaff() || isWorker();
    }
    // カフェの呼出番号（1日ごとの連番）。スタッフが1つずつ進めるだけ（戻したり飛ばしたりはできない）
    match /cafeCalls/{date} {
      allow read: if isStaff();
      allow create: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == 1;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == resource.data.last + 1;
    }
    // トータル実績の、ほかの売上（玉ねぎ・そば・作業委託＆冷蔵庫リース）の月ごとの金額：管理者だけ
    match /otherSales/{year} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && year.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['months', 'forecast', 'updatedAt'])
        && request.resource.data.months is map
        && request.resource.data.months.size() <= 12
        && (!('forecast' in request.resource.data) || (request.resource.data.forecast is map && request.resource.data.forecast.size() <= 12));
    }
    // 現金出納帳（月ごと）：管理者だけが読み書きできる
    match /cashbook/{month} {
      allow read: if isAdmin() || isAccounting();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['entries', 'opening', 'updatedAt'])
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 300
        && (!('opening' in request.resource.data) || request.resource.data.opening is number);
      allow delete: if isAdmin();
    }
    // タイムカード（タイムレコーダーの打刻・暦の月ごと）と、その計算のルール：管理者だけ
    match /timecards/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['cards', 'fileName', 'importedAt', 'updatedAt'])
        && request.resource.data.cards is map
        && request.resource.data.cards.size() <= 300
        && (!('fileName' in request.resource.data) || (request.resource.data.fileName is string && request.resource.data.fileName.size() <= 100));
      allow delete: if isAdmin();
    }
    match /config/timecard {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['format', 'cards', 'startTimes', 'roundIn', 'inDir', 'roundOut', 'outDir', 'breaks', 'overtimeOver', 'closeDay', 'rulesVersion', 'updatedAt'])
        && (!('rulesVersion' in request.resource.data) || request.resource.data.rulesVersion is int)
        && (!('startTimes' in request.resource.data) || (request.resource.data.startTimes is list && request.resource.data.startTimes.size() <= 50))
        && (!('inDir' in request.resource.data) || request.resource.data.inDir in ['up', 'down'])
        && (!('outDir' in request.resource.data) || request.resource.data.outDir in ['up', 'down'])
        && (!('overtimeOver' in request.resource.data) || (request.resource.data.overtimeOver is int && request.resource.data.overtimeOver > 0 && request.resource.data.overtimeOver <= 1440))
        && (!('format' in request.resource.data) || request.resource.data.format in ['dec', 'hm'])
        && (!('cards' in request.resource.data) || (request.resource.data.cards is map && request.resource.data.cards.size() <= 300))
        && (!('roundIn' in request.resource.data) || (request.resource.data.roundIn is int && request.resource.data.roundIn >= 1 && request.resource.data.roundIn <= 60))
        && (!('roundOut' in request.resource.data) || (request.resource.data.roundOut is int && request.resource.data.roundOut >= 1 && request.resource.data.roundOut <= 60))
        && (!('breaks' in request.resource.data) || (request.resource.data.breaks is list && request.resource.data.breaks.size() <= 5))
        && (!('closeDay' in request.resource.data) || (request.resource.data.closeDay is int && request.resource.data.closeDay >= 1 && request.resource.data.closeDay <= 31));
    }
    // 目標と実績（goals/{年}）：月ごとの目標と、ホーブへの支払いの実績
    match /goals/{year} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && year.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['targets', 'hobe', 'updatedAt'])
        && request.resource.data.targets is map && request.resource.data.targets.size() <= 12
        && request.resource.data.hobe is map && request.resource.data.hobe.size() <= 12;
    }
    match /payrolls/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['paymentDate', 'rows', 'employer', 'memo', 'payerAccount', 'author', 'updatedAt'])
        && (!('payerAccount' in request.resource.data) || (request.resource.data.payerAccount is string && request.resource.data.payerAccount.size() <= 30))
        && (!('author' in request.resource.data) || (request.resource.data.author is string && request.resource.data.author.size() <= 30))
        && request.resource.data.rows is map
        && request.resource.data.employer is map;
      allow delete: if isAdmin();
    }

    // ---------- 出荷実績（スタッフが入力。規格の設定は管理者） ----------
    match /shipping/config {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['destination', 'grades', 'updatedAt'])
        && request.resource.data.grades is list;
    }
    // 日ごとの出荷（shipments/{YYYY-MM-DD}）：規格ごとの数量と単価
    // 店舗実績（直売・カフェ・いちご狩りの売上と客数）：スタッフが入力する
    match /storeDaily/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['direct', 'directCustomers', 'cafe', 'cafeCustomers', 'ichigo', 'ichigoCustomers', 'total', 'totalCustomers', 'discount', 'airregi', 'updatedAt']);
      allow delete: if isStaff();
    }

    match /shipments/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is map;
      allow delete: if isStaff();
    }

    // ---------- 勤務管理表（従業員も見られる。名前と勤務の記号だけで、連絡先や給与は入れない） ----------
    // 勤務の表に並ぶ人。ログイン（uid・loginId）はサーバー側だけが付け替える
    match /shiftMembers/{id} {
      allow read: if isStaff() || isWorker();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'group', 'floor', 'harvest', 'harvestEntry', 'order', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'group', 'floor', 'harvest', 'harvestEntry', 'order', 'active', 'updatedAt', 'uid', 'loginId'])
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('loginId', null) == resource.data.get('loginId', null)
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin() && resource.data.get('uid', null) == null;
    }
    // 日ごとの勤務（shiftDays/{YYYY-MM-DD}）：人ごとの記号と、その日の予定
    match /shiftDays/{date} {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['cells', 'note', 'updatedAt'])
        && (!('cells' in request.resource.data) || request.resource.data.cells is map)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 50));
    }
    // 作業配置表：枠の並び（ひな形）と、日ごとの割り振り。見るのはスタッフと従業員、書くのは管理者
    match /config/haichi {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['sections', 'updatedAt'])
        && request.resource.data.sections is list && request.resource.data.sections.size() <= 20;
    }
    match /haichi/{date} {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['cells', 'note', 'done', 'updatedAt'])
        && request.resource.data.cells is map
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.done is bool;
    }
    // 勤務の記号・まとまり・希望の締め切り
    // 収穫の記録（だれがどのハウスで何ケース取ったか）：管理者は全部、スタッフは最近の日（8日前〜明日）、集荷係の従業員はその日だけ読み書きできる。集計は管理者だけ
    match /harvest/{date} {
      allow read: if isAdmin() || ((isStaff() || isHarvestWorker()) && recentDay(date)) || isPickupOn(date);
      // 収穫する従業員（収穫報告）は、読めずに、今日のハウスの「入った・終わった」の時刻だけ書ける（tapWrite）
      allow write: if date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (isAdmin() || ((isStaff() || isHarvestWorker()) && recentDay(date)) || isPickupOn(date) || tapWrite(date))
        && request.resource.data.keys().hasOnly(['houses', 'endTime', 'forecast', 'forecastHouses', 'casesForecast', 'break', 'tapHouse', 'updatedAt'])
        && (!('casesForecast' in request.resource.data) || (request.resource.data.casesForecast is number && request.resource.data.casesForecast >= 0 && request.resource.data.casesForecast < 100000))
        && (!('forecastHouses' in request.resource.data) || (request.resource.data.forecastHouses is map && request.resource.data.forecastHouses.size() <= 80))
        && (!('break' in request.resource.data) || (request.resource.data.break is map
          && request.resource.data.break.keys().hasOnly(['start', 'minutes'])
          && request.resource.data.break.start is int && request.resource.data.break.minutes is int
          && request.resource.data.break.minutes >= 0 && request.resource.data.break.minutes <= 180))
        && (!('forecast' in request.resource.data) || (request.resource.data.forecast is int && request.resource.data.forecast >= 0 && request.resource.data.forecast < 2880))
        && (!('houses' in request.resource.data) || (request.resource.data.houses is map && request.resource.data.houses.size() <= 80))
        && (!('endTime' in request.resource.data) || request.resource.data.endTime == null
          || (request.resource.data.endTime is int && request.resource.data.endTime >= 0 && request.resource.data.endTime < 1440));
    }
    // 収穫管理の入力の記録（何時何分に、だれが、どのハウスに何を入れたか）。あとで予測の精度を上げるために見る。
    // 入れられるのは収穫管理を使える人、見られるのは管理者だけ。あとから直したり消したりはできない
    match /harvest/{date}/log/{id} {
      allow read: if isAdmin();
      allow create: if (isAdmin() || ((isStaff() || isHarvestWorker()) && recentDay(date)) || isPickupOn(date) || (isWorker() && nearToday(date)))
        && request.resource.data.keys().hasOnly(['at', 'by', 'house', 'delta', 'cases', 'start', 'end', 'members', 'use', 'dayEnd', 'break', 'auto', 'tap'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid
        && (!('house' in request.resource.data) || (request.resource.data.house is string && request.resource.data.house.size() <= 10))
        && (!('delta' in request.resource.data) || request.resource.data.delta is number)
        && (!('cases' in request.resource.data) || request.resource.data.cases is number)
        && (!('start' in request.resource.data) || request.resource.data.start == null || request.resource.data.start is int)
        && (!('end' in request.resource.data) || request.resource.data.end == null || request.resource.data.end is int)
        && (!('dayEnd' in request.resource.data) || request.resource.data.dayEnd == null || request.resource.data.dayEnd is int)
        && (!('members' in request.resource.data) || (request.resource.data.members is list && request.resource.data.members.size() <= 20))
        && (!('use' in request.resource.data) || (request.resource.data.use is string && request.resource.data.use.size() <= 10))
        && (!('break' in request.resource.data) || (request.resource.data.break is map && request.resource.data.break.keys().hasOnly(['start', 'minutes'])))
        && (!('auto' in request.resource.data) || request.resource.data.auto is bool)
        && (!('tap' in request.resource.data) || request.resource.data.tap in ['in', 'out', 'undoIn', 'undoOut']);
    }
    // 収穫者が自分で押した「入った・終わった」（ハウス → 時刻）。書けるのは本人だけ（今日の分）。
    // 同じハウスの人が全員「終わった」を押したかを見るため、今日の分は従業員どうしで見られる（時刻だけで、個人情報は入れない）
    match /harvest/{date}/taps/{memberId} {
      allow read: if isStaff() || (isWorker() && nearToday(date));
      allow write: if isWorker() && nearToday(date)
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.memberId == memberId
        && request.resource.data.keys().hasOnly(['houses', 'updatedAt'])
        && request.resource.data.houses is map && request.resource.data.houses.size() <= 40;
    }
    // 休憩の合図（harvest/{date}/calls/break）：収穫管理を使える人（管理者・スタッフ・集荷係）が押す。今日の分は従業員も見られる（押した時刻だけ）
    match /harvest/{date}/calls/{id} {
      allow read: if isStaff() || (isWorker() && nearToday(date));
      allow write: if id == 'break'
        && (isAdmin() || ((isStaff() || isHarvestWorker()) && recentDay(date)) || isPickupOn(date))
        && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.at == request.time
        && request.resource.data.by == request.auth.uid;
    }
    // ハウスの使い方（収穫・いちご狩り・半分・予備・休み）：スタッフと、その日の集荷係の従業員が書く
    match /houseUse/{date} {
      allow read: if isStaff() || isWorker();
      allow write: if (isStaff() || isHarvestWorker() || isPickupOn(date))
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['houses', 'updatedAt'])
        && request.resource.data.houses is map && request.resource.data.houses.size() <= 80;
    }
    // ハウスのまとまり（集計で使う）
    match /config/harvest {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['groups', 'startTime', 'plants', 'noHelp', 'updatedAt'])
        && (!('noHelp' in request.resource.data) || (request.resource.data.noHelp is list && request.resource.data.noHelp.size() <= 40))
        && (!('plants' in request.resource.data) || (request.resource.data.plants is map && request.resource.data.plants.size() <= 80))
        && (!('groups' in request.resource.data) || (request.resource.data.groups is list && request.resource.data.groups.size() <= 20))
        && (!('startTime' in request.resource.data) || (request.resource.data.startTime is int && request.resource.data.startTime >= 0 && request.resource.data.startTime < 1440));
    }
    // ハウスの中の温度計（Govee）：一覧はサーバーが API キーで読んで入れる。管理者は、どの温度計がどのハウスかを決めるだけ。
    // API キーそのもの（secrets/govee）はルールを書かない＝画面からは誰も読み書きできない（サーバーだけが使う）
    match /config/govee {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['devices', 'houseOf', 'keySet', 'alertTemp', 'alertHigh', 'updatedAt'])
        && (!('alertHigh' in request.resource.data) || request.resource.data.alertHigh == null
          || (request.resource.data.alertHigh is number && request.resource.data.alertHigh >= 0 && request.resource.data.alertHigh <= 60))
        && (!('alertTemp' in request.resource.data) || (request.resource.data.alertTemp is number && request.resource.data.alertTemp >= -10 && request.resource.data.alertTemp <= 20))
        && request.resource.data.get('devices', []) == resource.data.get('devices', [])
        && request.resource.data.get('keySet', false) == resource.data.get('keySet', false)
        && (!('houseOf' in request.resource.data) || (request.resource.data.houseOf is map && request.resource.data.houseOf.size() <= 40));
    }
    // 管理者の助言（収穫の振り返りから。次の日から考えること）：管理者だけが読み書きできる
    match /harvestNotes/{id} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['text', 'from', 'until', 'sourceDate', 'done', 'createdAt', 'updatedAt'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.from is string && request.resource.data.from.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (request.resource.data.until == null || (request.resource.data.until is string && request.resource.data.until.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.done is bool;
    }
    // 温度の見張り担当（①②③の順。従業員リストの id）：従業員の携帯に「見張り画面を開く」を出すため、従業員も読める
    match /config/tempWatch {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['watchers', 'owner', 'updatedAt'])
        && request.resource.data.watchers is list && request.resource.data.watchers.size() <= 3
        && (!('owner' in request.resource.data) || (request.resource.data.owner is string && request.resource.data.owner.size() <= 40));
    }
    // いま出ている温度の警報（サーバーが20分ごとに入れる）。見られるのは管理者と見張り担当だけ。
    // 担当ができるのは「止めた」（だれが・いつ）を入れることだけ
    match /alerts/temp {
      allow read: if isAdmin() || isTempWatcher() || isTempOwner();
      allow update: if ((isAdmin() || isTempWatcher())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackBy', 'ackAt'])
        && request.resource.data.ackAt == request.time
        && request.resource.data.ackBy is string && request.resource.data.ackBy.size() <= 40)
        // 管理者（と管理者本人＝平山さんの従業員のログイン）の「警報をリセット」：いまの警報を消すだけ（まだ下がっていれば、次の確認でまた①から鳴る）
        || ((isAdmin() || isTempOwner())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['items', 'startedAt', 'ackBy', 'ackAt'])
          && request.resource.data.items.size() == 0 && request.resource.data.startedAt == null
          && request.resource.data.ackBy == null && request.resource.data.ackAt == null);
    }
    // ハウスの中の夜の温度（houseTemp/{その夜が明けた日}）：サーバーが20分ごとに入れる。見られるのは管理者だけ
    match /houseTemp/{date} {
      allow read: if isAdmin();
    }
    // 人ごとの収穫の速さ（1,000株あたりの分。収穫終了の予測に使う）：サーバーが毎日の記録から計算する。書き込みはサーバーだけ
    match /stats/harvestSpeed {
      allow read: if isStaff() || isWorker();
    }
    // 収穫ケース数の見込みに使う数字（まとまりごとの 1,000株あたりのケース数・天気の影響）。サーバーだけが書く
    match /stats/harvestYield {
      allow read: if isStaff() || isWorker();
    }
    // 去年の出荷実績から出した天気の影響（出荷の合計kgもふくむので管理者だけ）。サーバーだけが書く
    match /stats/pastYield {
      allow read: if isAdmin();
    }
    // 作業用フォルダ：総勘定元帳を読み取った明細（経費の仕分けに使う。経営の数字なので管理者だけ）。
    // ledgers/{期間のはじめ}：期間、accounts/{科目コード}：その科目の明細・月度合計・総合計
    match /ledgers/{period} {
      allow read: if isAdmin();
      allow write: if isAdmin() && period.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['from', 'to', 'updatedAt'])
        && request.resource.data.from is string && request.resource.data.to is string;
      match /accounts/{code} {
        allow read: if isAdmin();
        allow delete: if isAdmin();
        allow create, update: if isAdmin() && code.size() <= 20
          && request.resource.data.keys().hasOnly(['code', 'name', 'entries', 'monthTotals', 'grandTotal', 'updatedAt'])
          && request.resource.data.code == code
          && request.resource.data.name is string && request.resource.data.name.size() <= 40
          && request.resource.data.entries is list && request.resource.data.entries.size() <= 3000
          && request.resource.data.monthTotals is list && request.resource.data.monthTotals.size() <= 24;
      }
    }
    // 去年の出荷実績（日ごとの合計重量）：経営の数字なので管理者だけが読める。保存はサーバー（savePastShipments）だけ
    match /pastShipments/{season} {
      allow read: if isAdmin();
    }
    match /config/shift {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['codes', 'groups', 'cutoffDays', 'contact', 'updatedAt'])
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 20))
        && request.resource.data.codes is list && request.resource.data.codes.size() <= 30
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 10
        && request.resource.data.cutoffDays is int;
    }
    // 休みの希望：従業員は自分の分だけ見られる。出す・取り消すはサーバー側。管理者は承認・却下だけ変えられる
    match /shiftRequests/{id} {
      allow read: if isStaff() || (isWorker() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];
      allow delete: if isAdmin();
    }
    // 従業員のログインの情報：本人だけが見られる（書き込みはサーバー側）
    match /workers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // 設定：お客様用の予約ページでも使うので誰でも読める（個人情報は入れない）。
    // 変更は管理者だけ。決められた項目以外は保存できない。
    match /settings/main {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'storeName', 'storePhone', 'storeAddress', 'invoiceNumber',
          'seasonStart', 'seasonEnd', 'openTime', 'closeTime', 'closedDates',
          'bookingDaysAhead', 'bookingCutoffDays',
          'timeSlots', 'priceCategories', 'plans', 'products', 'tileLayout', 'updatedAt'
        ])
        && request.resource.data.timeSlots is list
        && request.resource.data.priceCategories is list
        && request.resource.data.plans is list
        && request.resource.data.closedDates is list
        && request.resource.data.bookingDaysAhead is int
        && request.resource.data.bookingCutoffDays is int;
    }
  }
}
