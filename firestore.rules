rules_version = '2';

// Firestore セキュリティルール
// 「誰が、どのデータを、読めるか・書けるか」を決める。書いていないものはすべて禁止。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 有効なスタッフ：ログイン情報の印（カスタムクレーム）があり、
    // かつスタッフ名簿（staff）で「有効」になっている人。無効にされた人はすぐ読めなくなる。
    function isStaff() {
      return signedIn()
        && request.auth.token.role in ['admin', 'staff']
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isStaff() && request.auth.token.role == 'admin';
    }
    // 従業員（勤務管理表を見る・休みの希望を出すだけの人）。ログインはサーバー側で作る
    function isWorker() {
      return signedIn()
        && request.auth.token.role == 'worker'
        && get(/databases/$(database)/documents/workers/$(request.auth.uid)).data.active == true;
    }

    // スタッフ名簿：スタッフは見るだけ。追加・変更はサーバー側（Cloud Functions）だけが行う
    match /staff/{uid} {
      allow read: if isStaff();
    }

    // 予約：スタッフは見るだけ。追加・変更・削除はサーバー側で定員を確かめてから行う
    match /reservations/{id} {
      allow read: if isStaff();
    }
    // 予約の連絡先（電話・メール）：スタッフだけが見られる。お客様本人も含め、他の人は読めない
    match /reservationContacts/{id} {
      allow read: if isStaff();
    }
    // 会計・売掛：スタッフは見るだけ。確定・取消・変更はサーバー側でまとめて行う
    match /sales/{id} {
      allow read: if isStaff();
    }
    match /receivables/{id} {
      allow read: if isStaff();
    }
    // 過去売上の取り込み（日ごとの合計）：スタッフは見るだけ、管理者が取り込む
    match /importedSales/{date} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['amount', 'source', 'importedAt'])
        && request.resource.data.amount is int;
      allow delete: if isAdmin();
    }

    // 顧客リスト（名前・連絡先・顧客ごとの単価）：スタッフは見るだけ（会計で使う）、管理者が登録・変更する
    match /customers/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'kana', 'phone', 'address', 'contract', 'payment', 'terms', 'memo', 'prices', 'products', 'active', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && (!('prices' in request.resource.data) || request.resource.data.prices is map)
        && (!('products' in request.resource.data) || (request.resource.data.products is map && request.resource.data.products.size() <= 200));
      allow delete: if isAdmin();
    }

    // レジ精算（日ごと）：スタッフが記録する。決められた項目だけ
    match /cashCounts/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['float', 'counts', 'cashSales', 'counted', 'diff', 'memo', 'updatedAt', 'updatedBy'])
        && request.resource.data.float is int
        && request.resource.data.counts is map
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // 請求書の設定（振込先など）：スタッフは見るだけ（請求書に印刷する）、変更は管理者
    match /config/invoice {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['bankInfo', 'note', 'updatedAt'])
        && request.resource.data.bankInfo is string
        && request.resource.data.bankInfo.size() <= 500;
    }

    // レジの共通設定（領収書の「扱者」に選ぶ名前のリスト）：スタッフが見て、直せる
    // メニューのタイルの配置：スタッフが読み、管理者が変える
    match /config/menu {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['slots', 'cols', 'updatedAt'])
        && request.resource.data.slots is map
        && request.resource.data.slots.size() <= 60
        && request.resource.data.cols is int
        && request.resource.data.cols >= 2 && request.resource.data.cols <= 6;
    }
    // 現金出納帳の「項目」の候補（プルダウン）：管理者だけ
    match /config/cashbookItems {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
    }
    match /config/register {
      allow read: if isStaff();
      allow write: if isStaff()
        && request.resource.data.keys().hasOnly(['handlers', 'updatedAt'])
        && request.resource.data.handlers is list
        && request.resource.data.handlers.size() <= 30;
    }

    // 去年の商品別の実績（Airレジの商品別CSV）：スタッフは見るだけ、管理者が取り込む
    match /itemReferences/{id} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['from', 'to', 'items', 'importedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 500;
      allow delete: if isAdmin();
    }

    // 空き状況（時間枠ごとの予約人数だけ）：予約ページで使うので誰でも読める。書き込みはサーバー側のみ
    match /availability/{date} {
      allow read: if true;
    }

    // この日だけの定員（時間枠ごと）：予約ページで使うので誰でも読める。変更は管理者だけ
    match /dailyCapacity/{date} {
      allow read: if true;
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['slots', 'stopped', 'updatedAt'])
        && (!('slots' in request.resource.data) || request.resource.data.slots is map)
        && (!('stopped' in request.resource.data) || request.resource.data.stopped is map);
    }

    // ---------- 給与（管理者だけ。スタッフには一切見せない） ----------
    // 従業員（氏名・振込先の口座など）
    match /employees/{id} {
      allow read, write: if isAdmin();
    }
    // 月ごとの給与（payrolls/{YYYY-MM}）
    // 気象データ（気象庁のアメダス・月ごと）：スタッフが見る。取り込みはサーバー側だけ
    match /weather/{month} {
      allow read: if isStaff();
    }
    // 天気予報（気象庁・上川地方）。書き込みはサーバー側だけ
    match /forecast/{id} {
      allow read: if isStaff() || isWorker();
    }
    // カフェの呼出番号（1日ごとの連番）。スタッフが1つずつ進めるだけ（戻したり飛ばしたりはできない）
    match /cafeCalls/{date} {
      allow read: if isStaff();
      allow create: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == 1;
      allow update: if isStaff()
        && request.resource.data.keys().hasOnly(['last', 'updatedAt'])
        && request.resource.data.last == resource.data.last + 1;
    }
    // トータル実績の、ほかの売上（玉ねぎ・そば・作業委託＆冷蔵庫リース）の月ごとの金額：管理者だけ
    match /otherSales/{year} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && year.matches('^[0-9]{4}$')
        && request.resource.data.keys().hasOnly(['months', 'forecast', 'updatedAt'])
        && request.resource.data.months is map
        && request.resource.data.months.size() <= 12
        && (!('forecast' in request.resource.data) || (request.resource.data.forecast is map && request.resource.data.forecast.size() <= 12));
    }
    // 現金出納帳（月ごと）：管理者だけが読み書きできる
    match /cashbook/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['entries', 'opening', 'updatedAt'])
        && request.resource.data.entries is list && request.resource.data.entries.size() <= 300
        && (!('opening' in request.resource.data) || request.resource.data.opening is number);
      allow delete: if isAdmin();
    }
    match /payrolls/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['paymentDate', 'rows', 'employer', 'memo', 'payerAccount', 'author', 'updatedAt'])
        && (!('payerAccount' in request.resource.data) || (request.resource.data.payerAccount is string && request.resource.data.payerAccount.size() <= 30))
        && (!('author' in request.resource.data) || (request.resource.data.author is string && request.resource.data.author.size() <= 30))
        && request.resource.data.rows is map
        && request.resource.data.employer is map;
      allow delete: if isAdmin();
    }

    // ---------- 出荷実績（スタッフが入力。規格の設定は管理者） ----------
    match /shipping/config {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['destination', 'grades', 'updatedAt'])
        && request.resource.data.grades is list;
    }
    // 日ごとの出荷（shipments/{YYYY-MM-DD}）：規格ごとの数量と単価
    // 店舗実績（直売・カフェ・いちご狩りの売上と客数）：スタッフが入力する
    match /storeDaily/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['direct', 'directCustomers', 'cafe', 'cafeCustomers', 'ichigo', 'ichigoCustomers', 'total', 'totalCustomers', 'discount', 'airregi', 'updatedAt']);
      allow delete: if isStaff();
    }

    match /shipments/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is map;
      allow delete: if isStaff();
    }

    // ---------- 勤務管理表（従業員も見られる。名前と勤務の記号だけで、連絡先や給与は入れない） ----------
    // 勤務の表に並ぶ人。ログイン（uid・loginId）はサーバー側だけが付け替える
    match /shiftMembers/{id} {
      allow read: if isStaff() || isWorker();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'group', 'floor', 'harvest', 'order', 'active', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'group', 'floor', 'harvest', 'order', 'active', 'updatedAt', 'uid', 'loginId'])
        && request.resource.data.get('uid', null) == resource.data.get('uid', null)
        && request.resource.data.get('loginId', null) == resource.data.get('loginId', null)
        && request.resource.data.name is string && request.resource.data.name.size() <= 30;
      allow delete: if isAdmin() && resource.data.get('uid', null) == null;
    }
    // 日ごとの勤務（shiftDays/{YYYY-MM-DD}）：人ごとの記号と、その日の予定
    match /shiftDays/{date} {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['cells', 'note', 'updatedAt'])
        && (!('cells' in request.resource.data) || request.resource.data.cells is map)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 50));
    }
    // 作業配置表：枠の並び（ひな形）と、日ごとの割り振り。見るのはスタッフと従業員、書くのは管理者
    match /config/haichi {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['sections', 'updatedAt'])
        && request.resource.data.sections is list && request.resource.data.sections.size() <= 20;
    }
    match /haichi/{date} {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['cells', 'note', 'done', 'updatedAt'])
        && request.resource.data.cells is map
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.done is bool;
    }
    // 勤務の記号・まとまり・希望の締め切り
    match /config/shift {
      allow read: if isStaff() || isWorker();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['codes', 'groups', 'cutoffDays', 'contact', 'updatedAt'])
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 20))
        && request.resource.data.codes is list && request.resource.data.codes.size() <= 30
        && request.resource.data.groups is list && request.resource.data.groups.size() <= 10
        && request.resource.data.cutoffDays is int;
    }
    // 休みの希望：従業員は自分の分だけ見られる。出す・取り消すはサーバー側。管理者は承認・却下だけ変えられる
    match /shiftRequests/{id} {
      allow read: if isStaff() || (isWorker() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedAt', 'decidedBy'])
        && request.resource.data.status in ['approved', 'rejected', 'pending'];
      allow delete: if isAdmin();
    }
    // 従業員のログインの情報：本人だけが見られる（書き込みはサーバー側）
    match /workers/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // 設定：お客様用の予約ページでも使うので誰でも読める（個人情報は入れない）。
    // 変更は管理者だけ。決められた項目以外は保存できない。
    match /settings/main {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'storeName', 'storePhone', 'storeAddress', 'invoiceNumber',
          'seasonStart', 'seasonEnd', 'openTime', 'closeTime', 'closedDates',
          'bookingDaysAhead', 'bookingCutoffDays',
          'timeSlots', 'priceCategories', 'plans', 'products', 'tileLayout', 'updatedAt'
        ])
        && request.resource.data.timeSlots is list
        && request.resource.data.priceCategories is list
        && request.resource.data.plans is list
        && request.resource.data.closedDates is list
        && request.resource.data.bookingDaysAhead is int
        && request.resource.data.bookingCutoffDays is int;
    }
  }
}
