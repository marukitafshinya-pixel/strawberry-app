rules_version = '2';

// Firestore セキュリティルール
// 「誰が、どのデータを、読めるか・書けるか」を決める。書いていないものはすべて禁止。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 有効なスタッフ：ログイン情報の印（カスタムクレーム）があり、
    // かつスタッフ名簿（staff）で「有効」になっている人。無効にされた人はすぐ読めなくなる。
    function isStaff() {
      return signedIn()
        && request.auth.token.role in ['admin', 'staff']
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return isStaff() && request.auth.token.role == 'admin';
    }

    // スタッフ名簿：スタッフは見るだけ。追加・変更はサーバー側（Cloud Functions）だけが行う
    match /staff/{uid} {
      allow read: if isStaff();
    }

    // 予約：スタッフは見るだけ。追加・変更・削除はサーバー側で定員を確かめてから行う
    match /reservations/{id} {
      allow read: if isStaff();
    }
    // 予約の連絡先（電話・メール）：スタッフだけが見られる。お客様本人も含め、他の人は読めない
    match /reservationContacts/{id} {
      allow read: if isStaff();
    }
    // 会計・売掛：スタッフは見るだけ。確定・取消・変更はサーバー側でまとめて行う
    match /sales/{id} {
      allow read: if isStaff();
    }
    match /receivables/{id} {
      allow read: if isStaff();
    }
    // 過去売上の取り込み（日ごとの合計）：スタッフは見るだけ、管理者が取り込む
    match /importedSales/{date} {
      allow read: if isStaff();
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['amount', 'source', 'importedAt'])
        && request.resource.data.amount is int;
      allow delete: if isAdmin();
    }

    // 空き状況（時間枠ごとの予約人数だけ）：予約ページで使うので誰でも読める。書き込みはサーバー側のみ
    match /availability/{date} {
      allow read: if true;
    }

    // この日だけの定員（時間枠ごと）：予約ページで使うので誰でも読める。変更は管理者だけ
    match /dailyCapacity/{date} {
      allow read: if true;
      allow write: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['slots', 'stopped', 'updatedAt'])
        && (!('slots' in request.resource.data) || request.resource.data.slots is map)
        && (!('stopped' in request.resource.data) || request.resource.data.stopped is map);
    }

    // ---------- 給与（管理者だけ。スタッフには一切見せない） ----------
    // 従業員（氏名・振込先の口座など）
    match /employees/{id} {
      allow read, write: if isAdmin();
    }
    // 月ごとの給与（payrolls/{YYYY-MM}）
    match /payrolls/{month} {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['paymentDate', 'rows', 'employer', 'memo', 'updatedAt'])
        && request.resource.data.rows is map
        && request.resource.data.employer is map;
      allow delete: if isAdmin();
    }

    // ---------- 出荷実績（スタッフが入力。規格の設定は管理者） ----------
    match /shipping/config {
      allow read: if isStaff();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['destination', 'grades', 'updatedAt'])
        && request.resource.data.grades is list;
    }
    // 日ごとの出荷（shipments/{YYYY-MM-DD}）：規格ごとの数量と単価
    match /shipments/{date} {
      allow read: if isStaff();
      allow write: if isStaff()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is map;
      allow delete: if isStaff();
    }

    // 設定：お客様用の予約ページでも使うので誰でも読める（個人情報は入れない）。
    // 変更は管理者だけ。決められた項目以外は保存できない。
    match /settings/main {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'storeName', 'storePhone', 'storeAddress', 'invoiceNumber',
          'seasonStart', 'seasonEnd', 'openTime', 'closeTime', 'closedDates',
          'bookingDaysAhead', 'bookingCutoffDays',
          'timeSlots', 'priceCategories', 'plans', 'products', 'updatedAt'
        ])
        && request.resource.data.timeSlots is list
        && request.resource.data.priceCategories is list
        && request.resource.data.plans is list
        && request.resource.data.closedDates is list
        && request.resource.data.bookingDaysAhead is int
        && request.resource.data.bookingCutoffDays is int;
    }
  }
}
