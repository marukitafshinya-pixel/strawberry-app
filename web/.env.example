# パソコン上で動かすときだけ使う設定です（.env.local という名前でコピーして使います）。
# Firebase Hosting に公開したときは、この値ではなく /__/firebase/init.json から自動で読み込みます。
# エミュレーター（練習用のFirebase）につなぐときは true
NEXT_PUBLIC_USE_EMULATOR=true
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ichigo-test-d0fa2
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
